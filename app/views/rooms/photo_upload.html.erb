<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <%= render 'room_menu' %>
        </div>
        <div class="col-md-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="mt-4 mb-4"><b>写真アップロード</b></h4>
                   <%= form_with model: @room, url: photo_upload_room_path do |f| %>
                    <% if @room.photo.attached? %>
                      <%= image_tag url_for(:photo) %>
                    <% else @room.photo.empty? %>
                      <%= image_tag 'default_room.png' %>
                   <% end %>

                   <%= f.file_field :photo %>
                    <%= f.submit %>
                   <% end %>

                    <div>
                     <%= button_to '削除', delete_photo_room_url, method: :delete,data: { confirm: "本当に削除してよろしいですか?" },style: "z-index: 100;",class: "btn btn-outline-danger btn-sm" %>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>