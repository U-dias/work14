<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <%= render 'room_menu' %>
        </div>
        <div class="col-md-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="mt-4 mb-4"><b>写真アップロード</b></h4>

                    <% if @room.photo.attached? %>
                     <div><%= image_tag(@room.photo) %></div>
                     <div><%= button_to '削除', delete_photo_room_url, 
                     method: :delete,
                     data: { confirm: "本当に削除してよろしいですか?" },
                     style: "z-index: 100;",
                     class: "btn btn-outline-danger btn-sm" %></div>
                    <% end %>

                    <%= form_with model: @room do |f| %>
                        <%= f.file_field :photo %>
                        <%= f.submit %>
                    <% end %>

                </div>
            </div>
        </div>